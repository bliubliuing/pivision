# ================= pivision MCP 服务环境变量 =================
# 5 段：视觉 ×2（r-pic / r-vid）+ 生图 ×3（g-pic / i-pic / p-pic）

# ---- r-pic 视觉识别（图片）----
VISION_ENABLED=true
VISION_PROVIDER=dots
VISION_MODEL=dots3-note-prev
VISION_BASE_URL=https://note3-prev-api.askdiandian.com/v1
VISION_API_KEY=

# ---- r-vid 视频识别（留空自动回退 VISION_*；ENABLED=false 则视频线单独停用）----
VISION_VIDEO_ENABLED=true
VISION_VIDEO_PROVIDER=
VISION_VIDEO_MODEL=
VISION_VIDEO_BASE_URL=
VISION_VIDEO_API_KEY=

# ---- g-pic 通用文生图 ----
GEN_IMAGE_ENABLED=true
GEN_IMAGE_ADAPTER=sensenova
GEN_IMAGE_MODEL=sensenova-u1.5-lite
GEN_IMAGE_BASE_URL=https://token.sensenova.cn/v1
GEN_IMAGE_API_KEYS=

# ---- i-pic 信息图文生图 ----
GEN_INFOGRAPH_ENABLED=true
GEN_INFOGRAPH_ADAPTER=sensenova
GEN_INFOGRAPH_MODEL=sensenova-u1-fast
GEN_INFOGRAPH_BASE_URL=https://token.sensenova.cn/v1
GEN_INFOGRAPH_API_KEYS=

# ---- p-pic 图生图 ----
EDIT_IMAGE_ENABLED=true
EDIT_IMAGE_ADAPTER=sensenova
EDIT_IMAGE_MODEL=sensenova-u1.5-lite
EDIT_IMAGE_BASE_URL=https://token.sensenova.cn/v1
EDIT_IMAGE_API_KEYS=

# ---- 命名实例（可选，以 g-pic 为例；机制见 3.7）----
# 声明实例列表后，即可用 g-pic(..., instance="a") 调用；未配置的字段自动回退主实例。
# GEN_IMAGE_INSTANCES=a
# GEN_IMAGE_A_MODEL=sensenova-u1-fast
# GEN_IMAGE_A_BASE_URL=https://token.sensenova.cn/v1
# GEN_IMAGE_A_API_KEYS=
